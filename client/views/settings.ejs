<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Sign Speak - AI | Settings</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/settings.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>
<body>
  <div class="app-grid">
    <!-- Main Content -->
    <div class="main-content">
      <div class="container">
        <h1>Settings</h1>

        <ul class="settings-list">
          <li>
              <a href="/application_settings" class="setting-link">
                <i class="fa fa-cog"></i> Application settings
              </a>
          </li>
          <!-- Camera Selection -->
          <li>
            <div class="setting-link" style="display: flex; flex-direction: column; align-items: flex-start; gap: 6px; cursor: default;">
              <div style="display:flex; align-items:center; gap:6px; font-weight:600;">
                <i class="fa fa-video"></i> <span>Camera Source</span>
              </div>
              <select id="cameraSelect" aria-label="Select camera" style="width:100%; padding:8px; border-radius:6px; border:1px solid #444; background:#1f1f1f; color:#fff;">
                <option value="" disabled selected>Loading cameras...</option>
              </select>
              <div style="display:flex; gap:8px; align-items:center; margin-top:6px; width:100%;">
                <button id="detectCamerasBtn" class="btn ghost" type="button" style="padding:6px 10px;">
                  <i class="fa fa-search"></i> Detect cameras
                </button>
                <small id="cameraSelectStatus" style="color:#aaa; font-size:11px;">We'll list available video inputs once permission is granted.</small>
              </div>
            </div>
          </li>
          <li>
            <a href="/privacy-policy" class="setting-link">
              <i class="fa fa-lock"></i> Privacy Policy
            </a>
          </li>
          <li>
            <a href="/terms-and-conditions" class="setting-link">
              <i class="fa fa-file-alt"></i> Terms and Conditions
            </a>
          </li>

          <li class="danger" id="change-password-btn"><i class="fa fa-key"></i> Change password</li>
          <li class="danger" id="change-email-btn"><i class="fa fa-envelope"></i> Change email</li>
        </ul>

        <div class="logout-section">
          <a href="/" class="logout-btn" id="logoutBtn"><i class="fa fa-sign-out-alt"></i> Logout</a>
        </div>
      </div>
    </div>

    <!-- Navigation Footer -->
    <div class="nav-wrapper">
      <%- include('partials/navigation') %>
    </div>
  </div>

  <!-- Settings Modals -->
  <div id="change-password-modal" class="settings-modal">
    <div class="settings-modal-content">
      <span class="close">&times;</span>
      <h2>Change Password</h2>
      <form id="change-password-form">
        <input type="password" id="current-password" placeholder="Current Password" required>
        <input type="password" id="new-password" placeholder="New Password" required>
        <input type="password" id="confirm-password" placeholder="Confirm New Password" required>
        <button type="submit">Change Password</button>
      </form>
    </div>
  </div>

  <div id="change-email-modal" class="settings-modal">
    <div class="settings-modal-content">
      <span class="close">&times;</span>
      <h2>Change Email</h2>
      <form id="change-email-form">
        <input type="email" id="new-email" placeholder="New Email" required>
        <button type="submit">Change Email</button>
      </form>
    </div>
  </div>

  <script src="/js/settings.js"></script>
</body>
</html>
