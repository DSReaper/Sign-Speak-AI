<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Sign Speak - AI | Detection</title>
    <%- include('partials/theme') %>
    <link rel="stylesheet" href="/css/style.css">
    <script>
        // Pass user-specific data to JavaScript
        window.userConfig = {
            userId: '<%= userId %>',
            userToken: '<%= userToken %>'
        };
    </script>
</head>
<body class="page-camera">
    <div class="app-grid">
        <!-- Main Content (90%) -->
        <div class="main-content">
            <div class="container camera-page">
                <!-- Camera Response Modal -->
                <div id="responseModal" class="camera-modal">
                    <div class="camera-modal-content">
                        <h2>Please type your response :)</h2>
                        <textarea id="userResponse" rows="4" placeholder="Type here..."></textarea>
                        <button id="closeModal">Close</button>
                    </div>
                </div>
                
                <!-- Camera Section -->
                <div class="camera-section" id="cameraSection">
                    <div class="camera-container" style="position: relative;">
                        <div class="camera-controls">
                            <div class="camera-options">
                                <button class="option-btn" id="toggleHands" style="visibility: hidden;"></button>
                                <button class="option-btn" id="resetBuffer" style="visibility: hidden;"></button>
                            </div>
                            <div class="expand-btn" id="expandBtn">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 
                                             18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 
                                             2h3"/>
                                </svg>
                            </div>
                        </div>

                        <!-- Local browser camera feed (replaces server image feed) -->
                        <video id="aiCameraFeed" autoplay muted playsinline style="display: block; width: 100%; height: 100%; object-fit: cover;"></video>

                        <!-- Overlay canvas for local hand drawing (drawn from hidden local video) -->
                        <canvas id="overlayCanvas" style="position: absolute; left: 0; top: 0; width: 100%; height: 100%; pointer-events: none; display: block; z-index: 5;" aria-hidden="true"></canvas>
                        
                        <!-- Camera Loading -->
                        <div class="camera-loading" id="cameraLoading">
                            <div class="loading-spinner"></div>
                        </div>

                        <!-- Camera Error -->
                        <div class="camera-error" id="cameraError" style="display: none;">
                            <p>No camera detected please check your camera permissions</p>
                            <button class="retry-btn" id="retryCamera">Try Again</button>
                        </div>

                        <!-- AI Status Display -->
                                <div class="ai-status" id="aiStatus">
                                    <div class="status-connection">
                            <span class="status-dot disconnected" id="connectionStatusDot" aria-hidden="true"></span>
                                        <span id="connectionStatusText">Disconnected</span>
                                    </div>
                                </div>
                    </div>
                </div>

                <!-- Detection Results -->
                <div class="results-section">
                    <h2 class="results-title">Detected sign(s):</h2>
                    <div class="detected-phrase" id="detectedPhrase">
                        Loading AI detection model...
                    </div>
                    
                    <!-- Audio Playback -->
                    <div class="audio-controls">
                        <button class="play-btn" id="playBtn">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                                <polygon points="5,3 19,12 5,21" fill="currentColor"/>
                        </svg>
                        <span>Play audio</span>
                    </button>
                    <button class="star-btn" id="starBtn">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polygon points="12,2 15.09,8.26 22,9.27 17,14.14
                                             18.18,21.02 12,17.77 5.82,21.02
                                             7,14.14 2,9.27 8.91,8.26"/>
                        </svg>
                    </button>
                    <button id="clearOutputBtn" class="clear-output-btn" title="Clear output" aria-label="Clear detected output">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="3 6 5 6 21 6" />
                            <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
                            <path d="M10 11v6" />
                            <path d="M14 11v6" />
                            <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" />
                        </svg>
                        <span>Clear output</span>
                    </button>
                </div>
            </div>
        </div>



        <!-- Navigation Footer (10%) -->
        <div class="nav-wrapper">
            <%- include('partials/navigation') %>
        </div>
    </div>

    <!-- MediaPipe: hands & drawing utils (client-side hand overlay) -->
    <script src="https://cdn.jsdelivr.net/npm/@mediapipe/hands/hands.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@mediapipe/drawing_utils/drawing_utils.js"></script>
    <script src="/js/play-audio.js"></script>
    <script src="/js/camera-acess.js"></script>
    
</body>
</html>