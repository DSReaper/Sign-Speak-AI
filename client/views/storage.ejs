<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
  <title>Sign Speak - AI | Stored Phrases</title>
  <%- include('partials/theme') %>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <div class="app-grid">
    <!-- Main Content (90%) -->
    <div class="main-content">
      <div id="storage-phrases-container" class="container">
        <!-- Camera Response Modal (shared with camera page) -->
        <div id="responseModal" class="camera-modal">
          <div class="camera-modal-content">
            <h2>Please type your response :)</h2>
            <textarea id="userResponse" rows="4" placeholder="Type here..."></textarea>
            <button id="closeModal">Close</button>
          </div>
        </div>

        <!-- Search Header -->
        <header class="storage-search-bar">
          <input id="storageSearchInput" type="text" class="storage-search-input" placeholder="Search" />
          <select id="storageSortSelect" class="storage-sort-select" aria-label="Sort stored phrases">
            <option value="">Sort </option>
            <option value="date-new-old">Date (new → old)</option>
            <option value="date-old-new">Date (old → new)</option>
            <option value="length-short-long">Phrase length (short → long)</option>
            <option value="length-long-short">Phrase length (long → short)</option>
          </select>
        </header>

        <!-- Main Content -->
        <main id="storage-main-content">
          <h2 class="storage-page-title">Stored Phrases</h2>
          <ul id="phrasesList" class="storage-phrase-list"></ul>

          <script>
            async function fetchPhrases() {
              try {
                const response = await fetch('/translate/phrases');
                if (!response.ok) {
                  throw new Error('Failed to fetch phrases');
                }
                const data = await response.json();
                const phrases = data.phrases || [];
                const phrasesList = document.getElementById('phrasesList');
                phrasesList.innerHTML = '';

                phrases.forEach((phrase, index) => {
                  const li = document.createElement('li');
                  li.className = 'storage-phrase-item';
                  li.setAttribute('data-phrase-id', phrase._id);

                  const date = new Date(phrase.timestamp).toLocaleDateString();

                  li.innerHTML = `
                    <div class="storage-phrase-content">
                      <!-- Star Button -->
                      <button class="storage-star-btn" data-phrase-id="${phrase._id}" data-starred="true" aria-label="Delete phrase">
                        <!-- Filled Star SVG -->
                        <svg class="storage-star-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                        </svg>
                      </button>

                      <!-- Phrase Text + Date Wrapper -->
                      <div class="storage-phrase-text-wrapper">
                        <span class="storage-phrase-text">"${phrase.text}"</span>
                        <div class="storage-phrase-date">${date}</div>
                      </div>

                      <!-- Play Button -->
                      <button class="storage-play-btn" data-phrase-index="${index}">
                        <!-- Play Button SVG -->
                        <svg class="storage-play-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                          <path d="M8 5v14l11-7z"/>
                        </svg>
                      </button>
                    </div>
                  `;
                  phrasesList.appendChild(li);
                });
              } catch (error) {
                console.error('Error fetching phrases:', error);
                const phrasesList = document.getElementById('phrasesList');
                phrasesList.innerHTML = '<li class="storage-phrase-item"><div class="storage-phrase-content">Error loading phrases. Please try again.</div></li>';
              }
            }

            // Fetch phrases when the page loads
            fetchPhrases();
          </script>
        </main>
      </div>
    </div>

    <!-- Navigation Footer (10%) -->
    <div class="nav-wrapper">
      <%- include('partials/navigation') %>
    </div>
  </div>

  <!-- Toggle Star Script -->
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      document.querySelectorAll(".storage-star-btn").forEach(button => {
        button.addEventListener("click", () => {
          const isStarred = button.getAttribute("data-starred") === "true";
          button.setAttribute("data-starred", !isStarred);

          // Replace SVG based on state
          if (isStarred) {
            button.innerHTML = `
              <!-- Outline Star SVG -->
              <svg class="storage-star-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>`;
          } else {
            button.innerHTML = `
              <!-- Filled Star SVG -->
              <svg class="storage-star-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>`;
          }
        });
      });
    });
  </script>
  <script src="/js/play-audio.js"></script>
  <script src="/js/storage.js"></script>
</body>
</html>
