<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>404 Page Not Found - Sign Speak</title>
    <link rel="stylesheet" href="/css/404.css">

</head>
<body>
  <div id="content" class="container">
    <div class="error-page">
      <h1>404 - Page Not Found</h1>
      <div id="face" class="face">(°ー°〃)</div>
      <p>Oops this page was not found, please return back to the home page :)</p>
      <a href="/" class="btn-primary">Return to Home</a>
    </div>
  </div>

  <script>
    // === Face animation ===
    const faces = ["(°ー°〃)", "(。_。)"];
    let currentFaceIndex = 0;
    const faceEl = document.getElementById("face");

    function switchFace() {
      currentFaceIndex = (currentFaceIndex + 1) % faces.length;
      faceEl.textContent = faces[currentFaceIndex];
    }

    // Switch faces every 1.5 seconds
    setInterval(switchFace, 1500);
  </script>
</body>
</html>