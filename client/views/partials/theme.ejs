<!-- Theme preloader: apply theme/text scale to avoid flash of other theme -->
<script>
  (function(){
    try {
      var raw = localStorage.getItem('appSettings');
      if (raw) {
        var s = JSON.parse(raw);
        var root = document.documentElement;
        if (s.theme && s.theme !== 'system') root.setAttribute('data-theme', s.theme);
        else root.removeAttribute('data-theme');
  // Text size setting removed; keep default font sizing
      }
    } catch(_){/* noop */}
  })();
  // Note: theme.js re-applies on DOMContentLoaded and listens to storage events
</script>
<script src="/js/theme.js" defer></script>
